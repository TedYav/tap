#!/usr/bin/env bash
# bin/tap — cwd-independent TAP entry point (the installed `tap` command).
#
# Resolves its OWN real path through any chain of symlinks (so `~/.local/bin/tap ->
# <repo>/bin/tap` works), then execs the Bun router (runtime/bun/main.ts). The bus
# is NOT anchored here: the router derives it from the caller's cwd enrollment
# (TAP_HOME only when no ancestor is enrolled), so `tap` behaves identically whether
# run as `bin/tap`, via the `~/.local/bin` symlink, or from a deep subdirectory.
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [ -h "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
here="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"

# A release artifact (tap-7r3fn.192) ships the compiled router at libexec/tap/tap and
# libexec/tap/bun, the shim that runs that router as Bun for TAP's own children: no Bun on
# PATH is needed. A BUN_BE_BUN leaked from a caller would turn the router into the Bun CLI,
# so it never reaches it. A checkout has no libexec/ and keeps `bun` from PATH.
tap_router="" tap_bun=bun
# A checkout's Bun must never treat the caller's directory as its project: Bun's
# default config is $PWD/bunfig.toml (its preload scripts run before the entry
# file) and it loads $PWD/.env. Every Bun started below gets TAP's own config
# and no env file, by a path derived from this script, never from the cwd.
tap_bun_config="$here/../runtime/bun/tap-bunfig.toml"
# Bun exits on a config path it cannot read. A missing file must not stop tap
# or reopen the door, so the empty device stands in for it.
[ -f "$tap_bun_config" ] || tap_bun_config=/dev/null
tap_bun_flags=(--config="$tap_bun_config" --no-env-file)
if [ -x "$here/../libexec/tap/tap" ] && [ -x "$here/../libexec/tap/bun" ]; then
  unset BUN_BE_BUN
  tap_router="$here/../libexec/tap/tap" tap_bun="$here/../libexec/tap/bun"
  tap_bun_flags=()
elif ! command -v bun >/dev/null 2>&1; then
  # Bun's own installer puts the binary under ~/.bun/bin (or $BUN_INSTALL/bin) and
  # adds that to PATH only in an interactive shell's rc file. A hook, a cron job
  # or an ssh one-liner then has no bun on PATH, so look where the installer puts
  # it. Resolved once here: the debug entrances below and the router share it.
  for tap_bun_candidate in "${BUN_INSTALL:+$BUN_INSTALL/bin/bun}" "${HOME:+$HOME/.bun/bin/bun}"; do
    if [ -n "$tap_bun_candidate" ] && [ -f "$tap_bun_candidate" ] && [ -x "$tap_bun_candidate" ]; then
      tap_bun="$tap_bun_candidate"
      break
    fi
  done
fi

# Internal handoff from the native pre-dispatcher to a Bash fallback. Never
# trust an inherited copy from the caller.
unset TAP_INTERNAL_OVERDUE_CHECKED

# Help options must be observational even before the native router starts.
# The separator leaves subsequent help-looking operands with their command.
tap_help_option=0 tap_help_verb=""
for tap_arg in "$@"; do
  if [ -z "$tap_help_verb" ]; then
    case "$tap_arg" in -v|--verbose) ;; *) tap_help_verb="$tap_arg" ;; esac
    if [ "$tap_help_verb" = help ]; then export BUN_RUNTIME_TRANSPILER_CACHE_PATH=0; fi
  fi
  case "$tap_arg" in
    --) break ;;
    help) export BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 ;;
    -h|--help) tap_help_option=1; export BUN_RUNTIME_TRANSPILER_CACHE_PATH=0; break ;;
  esac
done

# A stateless `tap ask` child skips this whole wrapper block: every debug route below execs its
# own entry point and writes or stops the machine recorder, so main.ts (which refuses `debug`
# with stateless_child and serves `help debug` as static help) must be the only door it has.
if [ "${TAP_STATELESS:-}" != 1 ]; then
# Debug is machine-wide and must work without initializing any team's bus.
# Global -v/--verbose flags ahead of it are stripped here, as main.ts strips
# them for every other verb, so `tap -v debug` never enters the router.
tap_lead=0
for tap_arg in "$@"; do
  case "$tap_arg" in -v|--verbose) tap_lead=$((tap_lead + 1)) ;; *) break ;; esac
done
if [ "$tap_lead" -gt 0 ]; then
  tap_after=("${@:tap_lead+1}")
  if [ "${tap_after[0]:-}" = debug ] || { [ "${tap_after[0]:-}" = help ] && [ "${tap_after[1]:-}" = debug ]; }; then
    export TAP_VERBOSE=1
    shift "$tap_lead"
  fi
fi
if [ "${1:-}" = debug ] && [ "$tap_help_option" -eq 1 ]; then
  set -- debug --help
fi
if [ "${1:-}" = debug ] && [ "${2:-}" = recovery ]; then
  exec "$tap_bun" ${tap_bun_flags[@]+"${tap_bun_flags[@]}"} "$here/../runtime/bun/src/recovery/artifacts.ts" "${@:3}"
fi
if [ "${1:-}" = debug ]; then
  case "${2:-}" in
    _attempt|_frame)
      tap_debug_rc=0
      tap_debug_error="$(
        [ ! -t 0 ] || exec </dev/null
        BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 exec "$tap_bun" ${tap_bun_flags[@]+"${tap_bun_flags[@]}"} "$here/../runtime/bun/src/debug-capture.ts" "${@:2}" 2>&1
      )" || tap_debug_rc=$?
      [ -z "$tap_debug_error" ] || printf '%s\n' "$tap_debug_error" >&2
      exit "$tap_debug_rc"
      ;;
  esac
fi
if [ "${1:-}" = help ] && [ "${2:-}" = debug ]; then
  set -- debug --help
fi
if [ "${1:-}" = debug ]; then
  # Keep Bun off every stdio TTY without mixing diagnostics into public JSON.
  BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 exec "$tap_bun" ${tap_bun_flags[@]+"${tap_bun_flags[@]}"} "$here/../runtime/bun/src/debug.ts" "${@:2}" </dev/null 9>&- > >(cat) 2> >(cat >&2)
fi
fi
# The verb is the first non-verbose argument: global -v/--verbose flags are
# stripped by main.ts, so `tap --verbose doctor` is still doctor. The
# subcommand is the first non-verbose argument AFTER the verb.
tap_words=()
for tap_arg in "$@"; do
  case "$tap_arg" in -v|--verbose) continue ;; esac
  tap_words+=("$tap_arg")
done
tap_verb="${tap_words[0]:-}" tap_sub="${tap_words[1]:-}"

# Init inventories all persistent writes, including on a fresh HOME. Its
# no-write preview cannot let Bun populate a cache before the verb starts.
if [ "$tap_verb" = init ]; then export BUN_RUNTIME_TRANSPILER_CACHE_PATH=0; fi
# Use the same effectful-command allowlist as debug-arm.ts. Everything else
# starts without Bun's cache, including unknown verbs and read-only subcommands.
tap_may_arm=0
while IFS= read -r tap_arm_command; do
  if [ "$tap_arm_command" = "$tap_verb" ] || [ "$tap_arm_command" = "$tap_verb $tap_sub" ]; then
    tap_may_arm=1
    break
  fi
done < "$here/../runtime/bun/src/debug-arm-commands.txt"
# Reminder scheduling names a recipient; list and missing/flag-led targets stay observational.
case "$tap_verb:$tap_sub" in remind:|remind:list|remind:-*) tap_may_arm=0 ;; esac
for tap_arg in "$@"; do
  case "$tap_arg" in help|-h|--help|--dry-run|--list-history) tap_may_arm=0 ;; esac
done
case "$tap_verb" in
  operate)
    for tap_arg in "${tap_words[@]}"; do [ "$tap_arg" != --observe ] || tap_may_arm=0; done ;;
  calibrate)
    tap_has_note=0
    for tap_arg in "${tap_words[@]}"; do [ "$tap_arg" != -f ] || tap_has_note=1; done
    [ "$tap_has_note" -eq 1 ] || tap_may_arm=0 ;;
  role)
    tap_role_operands=0 tap_role_skip=0 tap_role_unset=0
    for tap_arg in "${tap_words[@]:1}"; do
      if [ "$tap_role_skip" -eq 1 ]; then tap_role_skip=0; continue; fi
      case "$tap_arg" in
        --team) tap_role_skip=1 ;;
        --unset) tap_role_unset=1 ;;
        -*) ;;
        *) tap_role_operands=$((tap_role_operands + 1)) ;;
      esac
    done
    if [ "$tap_role_operands" -lt 2 ] && [ "$tap_role_unset" -eq 0 ]; then tap_may_arm=0; fi ;;
esac
if [ "$tap_may_arm" -eq 0 ]; then export BUN_RUNTIME_TRANSPILER_CACHE_PATH=0; fi

# Help-looking launch argv must not create Bun's startup cache. Native help
# routing owns the exact grammar (values and harness passthrough stay literal).
if [ "$tap_verb" = launch ] || { [ "$tap_verb" = session ] && [ "$tap_sub" = launch ]; }; then
  for tap_arg in "$@"; do
    case "$tap_arg" in -h|--help) export BUN_RUNTIME_TRANSPILER_CACHE_PATH=0; break ;; esac
  done
fi

if [ -n "$tap_router" ]; then
  # The compiled router is main.ts; it journals this public command in-process.
  TAP_INTERNAL_PUBLIC_COMMAND=1 exec "$tap_router" "$@"
fi
main="$here/../runtime/bun/main.ts"
# The checkout Bun resolved above: the one on PATH, else the installer's copy.
bun_bin="$(command -v "$tap_bun" 2>/dev/null || true)"
# Every verb runs in the Bun tree; without Bun or main.ts there is no fallback.
if [ -n "$bun_bin" ] && [ -x "$bun_bin" ] && [ -s "$main" ]; then
  shopt -s execfail
  set +e
  # main.ts journals this public command in-process when recording is on.
  TAP_INTERNAL_PUBLIC_COMMAND=1 exec "$bun_bin" ${tap_bun_flags[@]+"${tap_bun_flags[@]}"} "$main" "$@"
  set -e
fi

# A completion keystroke without a runtime offers nothing: an error line here
# would print under the prompt on every TAB press.
if [ "$tap_verb" = session ] && [ "$tap_sub" = complete ]; then exit 0; fi
if [ "$tap_verb" = completion ] && [ "$tap_sub" = candidates ]; then exit 0; fi
case "${OSTYPE:-}" in
  darwin*) bun_install_hint="brew install oven-sh/bun/bun" ;;
  *) bun_install_hint="curl -fsSL https://bun.sh/install | bash" ;;
esac
echo "tap: bun and runtime/bun/main.ts are required; next: $bun_install_hint, then rerun ./install.sh" >&2
exit 1
