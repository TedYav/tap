{
  "compilerOptions": {
    "lib": [
      "ESNext"
    ],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ],
    "noEmit": true,
    "paths": {
      "@opencode/plugin": [
        "./node_modules/@opencode/plugin/dist/promise/index.d.ts"
      ]
    }
  },
  "include": [
    "main.ts",
    "src",
    "test",
    "../../hooks/tap-opencode-session-start.ts",
    "../../hooks/tap-opencode-tmux-guard.ts"
  ]
}
