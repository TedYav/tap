#!/usr/bin/env bun
// Mock ps for session-context-right-handle.test.ts: the ancestry walk queries
// `ps -o ppid=,tty= -p <pid>`. The first call (the hook process itself) has a
// parent with no tty; the next hop ends at launchd owning ttys999 — the crew
// pane's tty. MOCK_PS_STATE makes the first-call behavior fire exactly once.
import { existsSync, readFileSync, writeFileSync } from "node:fs";

const argv = process.argv.slice(2);
const state = process.env.MOCK_PS_STATE ?? "";
if (argv[0] === "-Ao" && argv[1] === "pid=,pgid=,tpgid=,comm=,command=" && state && existsSync(state)) {
  const hook = Number(readFileSync(state, "utf8"));
  console.log(`${hook} ${hook - 1} ${hook - 1} bun bun /repo/session-start.ts claude`);
  console.log(`${hook - 1} ${hook - 1} ${hook - 1} claude claude`);
  process.exit(0);
}
let fields = "";
let pid = "";
for (let i = 0; i < argv.length; i++) {
  if (argv[i] === "-o") {
    fields = fields ? `${fields},${argv[i + 1]}` : argv[i + 1] ?? "";
    i++;
  } else if (argv[i] === "-p") {
    pid = argv[i + 1] ?? "";
    i++;
  } else {
    console.error(`ps mock: unexpected argument '${argv[i]}'`);
    process.exit(97);
  }
}
if (fields === "ppid=" && pid && state && existsSync(state)) {
  const hook = Number(readFileSync(state, "utf8"));
  console.log(Number(pid) === hook ? hook - 1 : 1);
  process.exit(0);
}
if (fields !== "ppid=,tty=" || !pid || !state) {
  console.error(`ps mock: unexpected query fields='${fields}' pid='${pid}'`);
  process.exit(97);
}
if (!existsSync(state)) {
  writeFileSync(state, pid);
  const parent = Number(pid) > 2 ? Number(pid) - 1 : 2;
  console.log(`${parent} ??`);
} else {
  console.log("1 ttys999");
}
